# %% [markdown]
# ### 4.1 Most frequent words, bigrams & trigrams per class

# %%
def top_ngrams(texts, n=1, top_k=15):
    counter = Counter()
    for t in texts:
        tokens = t.split()
        grams = tokens if n == 1 else [" ".join(tokens[i:i+n]) for i in range(len(tokens)-n+1)]
        counter.update(grams)
    return counter.most_common(top_k)

real_text = df[df.target == 1]["clean_text"]
not_real_text = df[df.target == 0]["clean_text"]

fig, axes = plt.subplots(1, 2, figsize=(13, 6))
for ax, (title, data, color) in zip(axes, [
    ("Top words — Real Disaster", top_ngrams(real_text, 1, 12), DISASTER_COLOR),
    ("Top words — Not a Disaster", top_ngrams(not_real_text, 1, 12), SAFE_COLOR),
]):
    words, cnts = zip(*data)
    ax.barh(words[::-1], cnts[::-1], color=color)
    ax.set_title(title, fontweight="bold")
plt.tight_layout()
plt.savefig("../assets/top_words.png", dpi=140)
plt.show()

