# %% [markdown]
# ## 5. Feature Engineering — TF-IDF
# Unigrams + bigrams, top 2,500 terms by document frequency (`min_df=2`).
# This vocabulary size is also what gets exported for the client-side live
# demo, so keeping it lean matters for both model quality and portability.

# %%
X_text = df["clean_text"].values
y = df["target"].values

X_train_text, X_test_text, y_train, y_test = train_test_split(
    X_text, y, test_size=0.2, random_state=RANDOM_STATE, stratify=y
)

vectorizer = TfidfVectorizer(max_features=2500, ngram_range=(1, 2), min_df=2, norm="l2", smooth_idf=True)
X_train = vectorizer.fit_transform(X_train_text)
X_test = vectorizer.transform(X_test_text)
print("TF-IDF matrix shape:", X_train.shape)

# %% [markdown]
# ## 6. Model Training & Comparison
#
# Required baseline (**Logistic Regression / SVM**) plus three additional
# models for a stronger comparison: **Multinomial Naive Bayes**, **Random
# Forest**, and **Gradient Boosting**.

# %%
models = {
    "Logistic Regression": LogisticRegression(max_iter=1000, C=1.0, random_state=RANDOM_STATE),
    "Linear SVM": CalibratedClassifierCV(LinearSVC(C=1.0, random_state=RANDOM_STATE, max_iter=5000), cv=3),
    "Multinomial Naive Bayes": MultinomialNB(alpha=0.5),
    "Random Forest": RandomForestClassifier(n_estimators=300, random_state=RANDOM_STATE, n_jobs=-1),
    "Gradient Boosting": GradientBoostingClassifier(n_estimators=200, max_depth=3, random_state=RANDOM_STATE),
}

results = {}
skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=RANDOM_STATE)

for name, model in models.items():
    model.fit(X_train, y_train)
    y_pred = model.predict(X_test)
    y_proba = model.predict_proba(X_test)[:, 1] if hasattr(model, "predict_proba") else None
    cv_f1 = cross_val_score(model, X_train, y_train, cv=skf, scoring="f1", n_jobs=-1)

    results[name] = {
        "accuracy": accuracy_score(y_test, y_pred),
        "precision": precision_score(y_test, y_pred),
        "recall": recall_score(y_test, y_pred),
        "f1": f1_score(y_test, y_pred),
        "roc_auc": roc_auc_score(y_test, y_proba) if y_proba is not None else np.nan,
        "cv_f1_mean": cv_f1.mean(),
        "cv_f1_std": cv_f1.std(),
    }
    print(f"{name:<26} Acc={results[name]['accuracy']:.3f}  F1={results[name]['f1']:.3f}  "
          f"AUC={results[name]['roc_auc']:.3f}  CV-F1={cv_f1.mean():.3f}±{cv_f1.std():.3f}")

# %% [markdown]
