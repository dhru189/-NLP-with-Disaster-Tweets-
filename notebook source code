# %% [markdown]
# ## 4. Text Preprocessing
#
# **Stage 1 — Regex cleaning:** lowercase, strip URLs, `@mentions`, HTML
# entities, the `#` symbol (the hashtag *word* is kept — e.g. `#earthquake` →
# `earthquake` — since it's a strong signal), punctuation and digits.
#
# **Stage 2 — NLTK preprocessing:** tokenize → remove stopwords (negations
# like "not"/"no" are deliberately kept, since they can flip a tweet's
# meaning) → lemmatize with `WordNetLemmatizer`.

# %%
STOPWORDS = set(stopwords.words("english")) - {"no", "not", "nor", "none", "never", "n't"}
LEMMATIZER = WordNetLemmatizer()

URL_RE = re.compile(r"https?://\S+|www\.\S+")
MENTION_RE = re.compile(r"@\w+")
HASHTAG_SYMBOL_RE = re.compile(r"#")
HTML_ENTITY_RE = re.compile(r"&\w+;")
NON_ALPHA_RE = re.compile(r"[^a-zA-Z\s]")
MULTI_SPACE_RE = re.compile(r"\s+")


def clean_tweet(text: str) -> str:
    text = text.lower()
    text = URL_RE.sub(" ", text)
    text = MENTION_RE.sub(" ", text)
    text = HTML_ENTITY_RE.sub(" ", text)
    text = HASHTAG_SYMBOL_RE.sub("", text)
    text = NON_ALPHA_RE.sub(" ", text)
    return MULTI_SPACE_RE.sub(" ", text).strip()


def preprocess(text: str) -> str:
    cleaned = clean_tweet(text)
    tokens = [t for t in word_tokenize(cleaned) if t not in STOPWORDS and len(t) > 1]
    tokens = [LEMMATIZER.lemmatize(t) for t in tokens]
    return " ".join(tokens)


# demo on the two examples from the brief
